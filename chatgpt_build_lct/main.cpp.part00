static std::wstring FormatTemp(double v)
{
    std::wostringstream ss;
    ss << std::fixed << std::setprecision(1) << v << L" C";
    return ss.str();
}

static std::wstring GetCpuName()
{
    HKEY key = nullptr;
    wchar_t buf[256] = {};
    DWORD type = 0;
    DWORD size = sizeof(buf);
    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE,
        L"HARDWARE\\DESCRIPTION\\System\\CentralProcessor\\0",
        0, KEY_READ, &key) == ERROR_SUCCESS)
    {
        if (RegQueryValueExW(key, L"ProcessorNameString", nullptr, &type,
            reinterpret_cast<LPBYTE>(buf), &size) == ERROR_SUCCESS &&
            (type == REG_SZ || type == REG_EXPAND_SZ))
        {
            RegCloseKey(key);
            return buf;
        }
        RegCloseKey(key);
    }
    return L"CPU name unavailable";
}

static bool VariantToWString(const VARIANT& v, std::wstring& out)
{
    if (v.vt == VT_BSTR && v.bstrVal)
    {
        out.assign(v.bstrVal, SysStringLen(v.bstrVal));
        return true;
    }
    return false;
}

static bool VariantToDouble(const VARIANT& v, double& out)
{
    switch (v.vt)
    {
    case VT_R4: out = v.fltVal; return true;
    case VT_R8: out = v.dblVal; return true;
    case VT_I2: out = v.iVal; return true;
    case VT_I4: out = v.lVal; return true;
    case VT_UI2: out = v.uiVal; return true;
    case VT_UI4: out = v.ulVal; return true;
    default: break;
    }
    VARIANT converted;
    VariantInit(&converted);
    if (SUCCEEDED(VariantChangeType(&converted, const_cast<VARIANT*>(&v), 0, VT_R8)))
    {
        out = converted.dblVal;
        VariantClear(&converted);
        return true;
    }
    VariantClear(&converted);
    return false;
}

static bool ContainsInsensitive(const std::wstring& text, const std::wstring& needle)
{
    if (needle.empty()) return true;
    std::wstring a = text;
    std::wstring b = needle;
    std::transform(a.begin(), a.end(), a.begin(), [](wchar_t c) { return static_cast<wchar_t>(towlower(c)); });
    std::transform(b.begin(), b.end(), b.begin(), [](wchar_t c) { return static_cast<wchar_t>(towlower(c)); });
    return a.find(b) != std::wstring::npos;
}

