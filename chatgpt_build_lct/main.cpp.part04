ext(g_list, row, 1, const_cast<LPWSTR>(cur.c_str()));
        ListView_SetItemText(g_list, row, 2, const_cast<LPWSTR>(minText.c_str()));
        ListView_SetItemText(g_list, row, 3, const_cast<LPWSTR>(maxText.c_str()));
    }
    g_minMaxInitialized = true;

    std::wostringstream ss;
    ss << L"LibreHardwareMonitor: connected | CPU sensors: " << readings.size()
       << L" | Current range: " << std::fixed << std::setprecision(1)
       << lowest << L" C - " << highest << L" C";
    SetWindowTextW(g_status, ss.str().c_str());
}

static void ResetMinMax()
{
    g_stats.clear();
    g_minMaxInitialized = false;
    RefreshSensors();
}

static void StartLibreHardwareMonitor()
{
    wchar_t exePath[MAX_PATH] = {};
    GetModuleFileNameW(nullptr, exePath, MAX_PATH);
    std::wstring base(exePath);
    size_t pos = base.find_last_of(L"\\/");
    if (pos != std::wstring::npos) base.resize(pos + 1);
    std::wstring path = base + L"Sensors\\LibreHardwareMonitor.exe";

    DWORD attr = GetFileAttributesW(path.c_str());
    if (attr == INVALID_FILE_ATTRIBUTES)
    {
        MessageBoxW(g_hwnd,
            L"Sensors\\LibreHardwareMonitor.exe was not found.\n\n"
            L"Download LibreHardwareMonitor from its official GitHub release, then copy the portable files into the Sensors folder.",
            APP_TITLE, MB_ICONINFORMATION);
        return;
    }

    HINSTANCE result = ShellExecuteW(g_hwnd, L"runas", path.c_str(), nullptr, nullptr, SW_SHOWNORMAL);
    if (reinterpret_cast<INT_PTR>(result) <= 32)
        MessageBoxW(g_hwnd, L"LibreHardwareMonitor could not be started.", APP_TITLE, MB_ICONWARNING);
}

static HWND MakeStatic(HWND parent, const wchar_t* text, int x, int y, int w, int h, int id = 0)
{
    HWND hWnd = CreateWindowExW(0, L"STATIC", text, WS_CHILD | WS_VISIBLE,
        x, y, w, h, parent, reinterpret_cast<HMENU>(static_cast<INT_PTR>(id)), GetModuleHandleW(nullptr), nullptr);
    SendMessageW(hWnd, WM_SETFONT, reinterpret_cast<WPARAM>(g_font), TRUE);
    return hWnd;
}

static HWND MakeButton(HWND parent, const wchar_t* text, int x, int y, int w, int h, int id)
{
    HWND hWnd = CreateWindowExW(0, L"BUTTON", text, WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON,
        x, y, w, h, parent, reinterpret_cast<HMENU>(static_cast<INT_PTR>(id)), GetModuleHandleW(nullptr), nullptr);
    SendMessageW(hWnd, WM_SETFONT, reinterpret_cast<WPARAM>(g_font), TRUE);
    return hWnd;
}

static HWND MakeCombo(HWND parent, int x, int y, int w, int h, int id)
{
    HWND hWnd = CreateWindowExW(0, WC_COMBOBOXW, L"",
        WS_CHILD | WS_VISIBLE | CBS_DROPDOWNLIST | WS_VSCROLL,
        x, y, w, h, parent, reinterpret_cast<HMENU>(static_cast<INT_PTR>(id)), GetModuleHandleW(nullptr), nullptr);
    SendMessageW(hWnd, WM_SETFONT, reinterpret_cast<WPARAM>(g_font), TRUE);
    return hWnd;
}

